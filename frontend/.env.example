# Public mode indicator only. Secrets are server-only and must never use NEXT_PUBLIC_.
NEXT_PUBLIC_MODE=demo
MODE=demo

# Required demo gate for every send action. Use a long random passcode.
DEMO_PASSCODE=
# Optional prefill for the demo form (visible in the browser bundle and form).
# Leave blank if you do not want the demo phone exposed to visitors.
NEXT_PUBLIC_DEMO_PHONE_NUMBER=

# Base URL of the n8n instance, for example https://automation.example.com
N8N_BASE_URL=
# Dedicated n8n Header Auth credential: Larynx31 Read API Header Auth
N8N_READ_API_HEADER_NAME=X-Larynx-Read-Token
N8N_READ_API_KEY=
# Dedicated intake Header Auth credential already selected on the intake webhook
N8N_INTAKE_AUTH_HEADER_NAME=X-API-KEY
N8N_INTAKE_AUTH_HEADER_VALUE=

# Optional explicit overrides; otherwise derived from N8N_BASE_URL.
N8N_READ_API_BASE_URL=
N8N_INTAKE_WEBHOOK_URL=
N8N_LIVE_SENDS_ENABLED=false

# Durable rate limiting is required for LIVE sends in production.
# Set these to an Upstash Redis REST database and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
